plot(production$vibration,
production$conso,
main = "Consommation en fonction des vibrations",
xlab = "Vibration (mm/s)",
ylab = "Consommation (W)",
col = "blue",
pch = 16)
abline(lm(conso ~ vibration, data = production),
col = "red",
lwd = 2)
cor(production$vibration, production$conso)
plot(production$vibration,
production$conso,
pch = 16,
col = "blue")
abline(lm(conso ~ vibration, data = production),
col = "red",
